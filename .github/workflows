name: Refresh data & deploy

on:
  push:
    branches: [main]
  schedule:
    - cron: "41 4 * * *"   # daily
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install openpyxl
      - name: Download the pollster sheet (public columns only)
        env:
          POLLSTER_SHEET_ID: ${{ secrets.POLLSTER_SHEET_ID }}
        run: |
          mkdir -p site/data
          python3 scripts/build_data.py site/data/pollsters.csv
          cp index.html style.css app.js site/
      - uses: actions/upload-pages-artifact@v3
        with:
          path: site

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
